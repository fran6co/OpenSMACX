{
  "schema_version": 1,
  "artifacts": "build/recovery/builds",
  "commands": [
    {"argv": ["cmake", "-S", "{root}", "-B", "{build}", "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Release", "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON", "-DOPENSMACX_CAPTURE_COMPILES=ON", "-DCMAKE_EXE_LINKER_FLAGS_RELEASE:STRING=/DEBUG /DEBUGTYPE:CV,FIXUP /PDBTYPE:SEPT /OPT:REF /OPT:ICF /INCREMENTAL:NO"], "timeout": 120},
    {"argv": ["cmake", "--build", "{build}", "--parallel", "4"], "timeout": 3300}
  ],
  "outputs": [{"path": "OpenSMACX.exe", "format": "pe32-i386"},
              {"path": "OpenSMACX.pdb", "format": "msvc-pdb"},
              {"path": "OpenSMACX.map", "format": "msvc-map"},
              {"path": "OpenSMACX.link.log", "format": "msvc-link-log"},
              {"path": "OpenSMACX.link.inputs.json", "format": "link-input-files"},
              {"path": "compile_commands.json", "format": "compilation-database"}],
  "compile_link": {
    "database": "compile_commands.json",
    "source_extensions": [".cpp"],
    "directory": "CMakeFiles/OpenSMACX.dir",
    "suffix": ".compile.json",
    "archive_members": [
      {"archive": "src/jackal/jackal.lib", "object": "src/jackal/CMakeFiles/jackal.dir/jackal.cpp.obj", "member": "src/jackal/CMakeFiles/jackal.dir/jackal.cpp.obj"},
      {"archive": "src/jackal/jackal.lib", "object": "src/jackal/CMakeFiles/jackal.dir/palette.cpp.obj", "member": "src/jackal/CMakeFiles/jackal.dir/palette.cpp.obj"},
      {"archive": "src/jackal/jackal.lib", "object": "src/jackal/CMakeFiles/jackal.dir/font.cpp.obj", "member": "src/jackal/CMakeFiles/jackal.dir/font.cpp.obj"},
      {"archive": "src/jackal/jackal.lib", "object": "src/jackal/CMakeFiles/jackal.dir/checkbox.cpp.obj", "member": "src/jackal/CMakeFiles/jackal.dir/checkbox.cpp.obj"},
      {"archive": "src/jackal/jackal.lib", "object": "src/jackal/CMakeFiles/jackal.dir/radiobutton.cpp.obj", "member": "src/jackal/CMakeFiles/jackal.dir/radiobutton.cpp.obj"},
      {"archive": "src/jackal/jackal.lib", "object": "src/jackal/CMakeFiles/jackal.dir/checkbutton.cpp.obj", "member": "src/jackal/CMakeFiles/jackal.dir/checkbutton.cpp.obj"}
    ],
    "command_stages": {"compile": "compiler-effective", "link": "link-wrapper"},
    "link_files": "OpenSMACX.link.inputs.json",
    "link_log": "OpenSMACX.link.log"
  },
  "inputs": ["CMakeLists.txt", "pyproject.toml", "uv.lock", "recovery/terrain_data.py", "recovery/environment/vc6-cl", "recovery/environment/vc6-link", "recovery/environment/vc6-lib", "recovery/environment/wine.py", "recovery/environment/wine_link.py", "recovery/environment/wine_repro.py", "recovery/environment/wine_compile.py"],
  "input_roots": ["src", "cmake"],
  "versioned_inputs": ["CMakeLists.txt"],
  "environment": ["VC6_PREFIX", "VC6_ROOT", "VC6_INCLUDE", "VC6_LIB", "WINEARCH", "CL", "_CL_", "OPENSMACX_IMAGE"]
}
