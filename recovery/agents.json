{
  "schema_version": 1,
  "artifacts": "build/recovery/agents",
  "worker": {
    "command": {
      "argv": ["codex", "exec", "--ephemeral", "--sandbox", "workspace-write", "--add-dir", "{env:VC6_PREFIX}", "--output-schema", "{schema}", "--output-last-message", "{response}", "-"],
      "timeout": 3300
    },
    "instructions": [".claude/agents/recovery-worker.md"],
    "response": "file"
  },
  "reviewer": {
    "command": {
      "argv": ["codex", "exec", "--ephemeral", "--sandbox", "read-only", "--output-schema", "{schema}", "--output-last-message", "{response}", "-"],
      "timeout": 3300
    },
    "instructions": [".claude/agents/recovery-reviewer.md"],
    "response": "file"
  }
}
