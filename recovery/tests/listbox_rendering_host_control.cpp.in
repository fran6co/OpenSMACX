#include <cassert>
#include <cstdint>
#include <cstdlib>
#include <cstring>

struct RECT { int left, top, right, bottom; };
struct Win;
struct GraphicWin;
struct ListBox;
using uint32_t = unsigned int;

struct StringStructPayload {
    unsigned int field_C_;
    unsigned int field_8_;
    char *text;
};

struct StringStructEntry {
    StringStructEntry *next;
    StringStructEntry *previous;
    StringStructPayload payload;
    StringStructPayload *string_payload() { return &payload; }
};

struct StringList {
    int entry_count_;
    StringStructEntry *head_;
    StringStructEntry *current_;
    int current_position_;
    StringList() : entry_count_(0), head_(0), current_(0), current_position_(0) {}
};

struct Buffer {
    int copies;
    Buffer *copy_destination;
    int sx, sy, dx, dy, width, height;
    int clips, boxes, wraps, writes;
    int buffer_rect_fills, buffer_rect_fill_color;
    RECT first_clip, last_clip, clips_seen[16], buffer_rect_fill_rect;
    int first_clip_set;
    Buffer() : copies(0), copy_destination(0), sx(0), sy(0), dx(0), dy(0),
               width(0), height(0), clips(0), boxes(0), wraps(0), writes(0),
               buffer_rect_fills(0), buffer_rect_fill_color(0), first_clip_set(0) {}
    int pixel_width() const { return 37; }
    int pixel_height() const { return 19; }
    int copy(Buffer *source, int x, int y, int to_x, int to_y, int w, int h) {
        ++copies; copy_destination = source; sx=x; sy=y; dx=to_x; dy=to_y;
        width=w; height=h; return 1; // original ignores this result
    }
    void set_clip(RECT *r) {
        if (clips == 0) { first_clip = *r; first_clip_set = 1; }
        if (clips < 16) clips_seen[clips] = *r;
        ++clips;
        last_clip = *r;
    }
    void fill(RECT *r, int color) {
        ++buffer_rect_fills; buffer_rect_fill_color=color;
        buffer_rect_fill_rect=*r;
    }
    void set_text_color(int, int, int, int) {}
    void set_text_color2(int, int, int, int) {}
    void set_text_color3(int, int, int, int) {}
    void set_font(void *, void *, void *, int) {}
    int box(RECT *, int, int) { ++boxes; return 0; }
    void wrap(char *, RECT *) { ++wraps; }
    void write_l(char *, RECT *, int) { ++writes; }
    void write_right_l(char *, RECT *, int) { ++writes; }
};

struct Win {
    Win *parent_;
    unsigned int iFlags_;
    int slot_calls;
    GraphicWin *slot_window;
    int slot_index, slot_state;
    RECT *slot_rect;
    int slot_result;
    ListBox *mutate_child;
    Win *mutate_parent;
    ListBox *mutate_list;
    int mutate_count;
    int dialog_focus_, focus_checks;
    Win() : parent_(0), iFlags_(0), slot_calls(0), slot_window(0),
            slot_index(0), slot_state(0), slot_rect(0), slot_result(0),
            mutate_child(0), mutate_parent(0), mutate_list(0), mutate_count(0),
            dialog_focus_(0), focus_checks(0) {}
    Win *parent_window() { return parent_; }
    int is_dialog_focus() { ++focus_checks; return dialog_focus_; }
    bool has_listbox_backfill_flag() const { return (iFlags_ & 0x80000u) != 0; }
    virtual int on_dialog_item_back_draw(GraphicWin *window, int index, int state, RECT *rect);
};

struct GraphicWin : Win, Buffer {
    RECT work;
    int fills, fill_value, redraws, updates;
    int graphic_rect_fills, graphic_rect_fill_color;
    RECT graphic_rect_fill_rect;
    GraphicWin() : fills(0), fill_value(0), redraws(0), updates(0) {
        work.left=1; work.top=2; work.right=40; work.bottom=22;
        graphic_rect_fills=0; graphic_rect_fill_color=0;
    }
    void fill(int value) { ++fills; fill_value=value; }
    void fill(RECT *r, int color) {
        ++graphic_rect_fills; graphic_rect_fill_color=color;
        graphic_rect_fill_rect=*r;
    }
    RECT *buffer_working_rect() { return &work; }
    void redraw() { ++redraws; }
    void soft_update() { ++updates; }
};

struct Dialog {
    StringList item_list_;
    int selected_position_;
    int field_4C_, field_64_, field_44_, field_68_;
    int row_count_;
    int field_38_, field_40_;
    uint32_t field_6C_, field_F0_;
    uint32_t field_B4_, field_AC_, field_B0_, field_34_;
    uint32_t text_color_a_, text_color_b_, text_color_c_, text_color_d_;
    uint32_t text_color_2a_, text_color_2b_, text_color_2c_, text_color_2d_;
    uint32_t text_color_3a_, text_color_3b_, text_color_3c_, text_color_3d_;
    void *font1_, *font2_, *font3_;
    Dialog() : selected_position_(0), field_4C_(0), field_64_(8),
        field_44_(1), field_68_(6), row_count_(2), field_38_(0), field_40_(0), field_6C_(9),
        field_F0_(~0u), field_B4_(1), field_AC_(3), field_B0_(4), field_34_(0),
        text_color_a_(1), text_color_b_(2), text_color_c_(3), text_color_d_(4),
        text_color_2a_(5), text_color_2b_(6), text_color_2c_(7), text_color_2d_(8),
        text_color_3a_(9), text_color_3b_(10), text_color_3c_(11), text_color_3d_(12),
        font1_(0), font2_(0), font3_(0) {}
    int pos_to_id(int position) { return 1000 + position; }
};

using DrawCallback = void (*)(GraphicWin *, int, int, int, int, int);
using WriteCallback = int (*)(GraphicWin *, int, int, RECT *, char *);
using FillCallback = int (*)(GraphicWin *, int, int, RECT *);

struct ListBox : virtual GraphicWin, virtual Dialog {
    uint32_t field_4_, field_10_, field_14_, field_18_, field_24_, field_28_, field_2C_;
    FillCallback fill_callback_;
    DrawCallback draw_callback_;
    WriteCallback write_callback_;
    ListBox() : field_4_(0), field_10_(~0u), field_14_(~0u), field_18_(0), field_24_(0), field_28_(0),
                field_2C_(0), fill_callback_(0), draw_callback_(0),
                write_callback_(0) {}
    void set_draw_callback(DrawCallback callback) { draw_callback_=callback; }
    void set_selected_pos(int position, int) { selected_position_ = position; }
    void on_scrolling(int, int);
    void draw_item(int);
};

struct Dialogs : ListBox {
    int kind_;
    Dialogs() : kind_(0) {}
    void on_scrolled(int, int);
    void on_scrolling(int, int);
};

int Win::on_dialog_item_back_draw(GraphicWin *window, int index, int state, RECT *rect) {
    ++slot_calls; slot_window=window; slot_index=index; slot_state=state;
    slot_rect=rect;
    if (mutate_child != 0) mutate_child->parent_ = mutate_parent;
    if (mutate_list != 0) mutate_list->item_list_.entry_count_ = mutate_count;
    return slot_result;
}

static Win *WinCallbackWindow;
static int ListBoxGlobalDDC;
static int ListBoxDrawOffset;
static ListBox *CurrentListBoxDraw;

#include "actual_listbox_rendering.inc"

static int fill_calls;
static RECT fill_rect;
static int fill_cursor_position;
static StringStructEntry *fill_cursor;
static int fill_result;
static ListBox *fill_target;
static int fill_draw_position;
static int same_rect(const RECT &a, const RECT &b) {
    return a.left == b.left && a.top == b.top
        && a.right == b.right && a.bottom == b.bottom;
}
static int fill(GraphicWin *window, int, int draw_position, RECT *rect) {
    ++fill_calls; fill_rect=*rect;
    fill_draw_position=draw_position;
    assert(window == static_cast<GraphicWin *>(fill_target));
    assert(window->first_clip_set && same_rect(window->first_clip, *rect));
    fill_cursor_position = fill_target->item_list_.current_position_;
    fill_cursor = fill_target->item_list_.current_;
    return fill_result;
}

static int bridge_draw_calls;
static GraphicWin *bridge_draw_window;
static int bridge_draw_ids[8];
static ListBox *draw_target;
static StringStructEntry *draw_cursor;
static int draw_cursor_position;
static void bridge_draw_with_id(GraphicWin *window, int item_id, int, int, int, int) {
    bridge_draw_ids[bridge_draw_calls]=item_id;
    ++bridge_draw_calls; bridge_draw_window=window;
    if (draw_target != 0) {
        draw_cursor=draw_target->item_list_.current_;
        draw_cursor_position=draw_target->item_list_.current_position_;
    }
}

static void link_rows(StringStructEntry *rows, int count, unsigned int *spans) {
    for (int i=0; i<count; ++i) {
        rows[i].next=&rows[(i+1)%count];
        rows[i].previous=&rows[(i+count-1)%count];
        rows[i].payload.field_C_=spans[i];
        rows[i].payload.field_8_=0;
        rows[i].payload.text=(char *)"row";
    }
}

int main() {
    StringStructEntry rows[8];
    unsigned int spans[8] = {2, 3, 4, 5, 6, 7, 8, 9};
    link_rows(rows, 8, spans);

    ListBox focused_row;
    focused_row.item_list_.entry_count_=8; focused_row.item_list_.head_=&rows[0];
    focused_row.item_list_.current_=&rows[0]; focused_row.selected_position_=0;
    focused_row.field_14_=77; focused_row.dialog_focus_=1;
    focused_row.field_38_=3; focused_row.field_40_=7;
    focused_row.field_64_=31; focused_row.field_68_=11;
    focused_row.draw_item(0);
    const RECT full_focus_row={7, 3, 24, 14};
    assert(focused_row.focus_checks==1 && focused_row.graphic_rect_fills==1);
    assert(focused_row.graphic_rect_fill_color==77);
    assert(same_rect(focused_row.graphic_rect_fill_rect, full_focus_row));
    assert(focused_row.buffer_rect_fills==0);
    assert(focused_row.clips_seen[2].left==full_focus_row.left
        && same_rect(focused_row.clips_seen[2], full_focus_row));

    ListBox unfocused_row;
    unfocused_row.item_list_.entry_count_=8; unfocused_row.item_list_.head_=&rows[0];
    unfocused_row.item_list_.current_=&rows[0]; unfocused_row.selected_position_=0;
    unfocused_row.field_14_=77; unfocused_row.dialog_focus_=0;
    unfocused_row.field_38_=3; unfocused_row.field_40_=7;
    unfocused_row.field_64_=31; unfocused_row.field_68_=11;
    unfocused_row.draw_item(0);
    const RECT inset_focus_row={8, 3, 23, 14};
    assert(unfocused_row.focus_checks==1 && unfocused_row.graphic_rect_fills==0);
    assert(unfocused_row.buffer_rect_fills==0);
    assert(same_rect(unfocused_row.clips_seen[2], inset_focus_row));

    // The image clips the selected full row even when the selected fill color
    // is the -1 sentinel; only the fill call is suppressed.
    ListBox sentinel_focus_row;
    sentinel_focus_row.item_list_.entry_count_=8;
    sentinel_focus_row.item_list_.head_=&rows[0];
    sentinel_focus_row.item_list_.current_=&rows[0];
    sentinel_focus_row.selected_position_=0;
    sentinel_focus_row.field_14_=~0u; sentinel_focus_row.dialog_focus_=1;
    sentinel_focus_row.field_38_=3; sentinel_focus_row.field_40_=7;
    sentinel_focus_row.field_64_=31; sentinel_focus_row.field_68_=11;
    sentinel_focus_row.draw_item(0);
    assert(sentinel_focus_row.focus_checks==1
        && sentinel_focus_row.graphic_rect_fills==0);
    assert(sentinel_focus_row.buffer_rect_fills==0);
    assert(same_rect(sentinel_focus_row.clips_seen[2], full_focus_row));

    ListBox box;
    box.item_list_.entry_count_=8; box.item_list_.head_=&rows[0];
    box.item_list_.current_=&rows[0]; box.item_list_.current_position_=0;
    box.fill_callback_=&fill;
    box.field_4C_=1; // variable-height rows: exercise circular cursor path
    box.field_4_=0;  // selection comes from Dialog, so callback observes layout cursor
    box.field_18_=0; box.selected_position_=7;
    box.field_38_=3; box.field_40_=7; // asymmetric top and left inset
    box.field_64_=31; box.field_68_=11; box.field_44_=2;
    fill_target=&box; fill_calls=0; box.draw_item(1);
    assert(fill_calls==1);
    assert(fill_cursor==&rows[1] && fill_cursor_position==1);
    assert(fill_draw_position==0);
    assert(fill_rect.left==7 && fill_rect.top==29);
    assert(fill_rect.right==24 && fill_rect.bottom==66);
    assert(box.first_clip_set && same_rect(box.first_clip, fill_rect));
    assert(box.item_list_.current_==&rows[1]);

    // Grid mode's nonzero quotient and remainder separate the axes: width
    // advances left/right, while height advances top/bottom.
    ListBox grid;
    grid.item_list_.entry_count_=8; grid.item_list_.head_=&rows[0];
    grid.item_list_.current_=&rows[0]; grid.item_list_.current_position_=0;
    grid.fill_callback_=&fill; grid.field_4C_=0; grid.field_4_=0;
    grid.field_18_=0; grid.row_count_=3; grid.selected_position_=7;
    grid.field_38_=3; grid.field_40_=7;
    grid.field_64_=31; grid.field_68_=11; grid.field_44_=2;
    fill_target=&grid; fill_calls=0; grid.draw_item(5); // 5 / 3 = 1, 5 % 3 = 2
    assert(fill_calls==1 && fill_cursor==&rows[0]);
    assert(fill_rect.left==40 && fill_rect.top==29);
    assert(fill_rect.right==57 && fill_rect.bottom==40);
    assert(grid.first_clip_set && same_rect(grid.first_clip, fill_rect));

    // Negative row indices return before cursor changes, clipping or callbacks.
    ListBox negative_index;
    negative_index.item_list_.entry_count_=8;
    negative_index.item_list_.head_=&rows[0];
    negative_index.item_list_.current_=&rows[3];
    negative_index.item_list_.current_position_=3;
    negative_index.fill_callback_=&fill;
    fill_target=&negative_index; fill_calls=0;
    negative_index.draw_item(-1);
    assert(fill_calls==0 && negative_index.clips==0);
    assert(negative_index.item_list_.current_==&rows[3]);

    // A zero top cursor starts at row zero after the circular predecessor
    // setup; the callback sees the pinned top-based span bottom.
    ListBox zero_cursor;
    zero_cursor.item_list_.entry_count_=8; zero_cursor.item_list_.head_=&rows[0];
    zero_cursor.item_list_.current_=&rows[5];
    zero_cursor.item_list_.current_position_=5;
    zero_cursor.fill_callback_=&fill; zero_cursor.field_4C_=1;
    zero_cursor.field_18_=0; zero_cursor.field_4_=0;
    zero_cursor.field_38_=3; zero_cursor.field_40_=7;
    zero_cursor.field_64_=31; zero_cursor.field_68_=11; zero_cursor.field_44_=2;
    fill_target=&zero_cursor; fill_calls=0; zero_cursor.draw_item(0);
    assert(fill_calls==1 && fill_cursor==&rows[0] && fill_cursor_position==0);
    assert(fill_rect.left==7 && fill_rect.top==3);
    assert(fill_rect.right==24 && fill_rect.bottom==27);

    // Negative scroll position uses the pinned abs/wrap walk. With -1 it
    // counts row seven as occupied, then exposes row zero to the callback.
    ListBox negative_cursor;
    negative_cursor.item_list_.entry_count_=8; negative_cursor.item_list_.head_=&rows[0];
    negative_cursor.item_list_.current_=&rows[2];
    negative_cursor.item_list_.current_position_=2;
    negative_cursor.fill_callback_=&fill; negative_cursor.field_4C_=1;
    negative_cursor.field_18_=static_cast<uint32_t>(-1); negative_cursor.field_4_=0;
    negative_cursor.field_38_=3; negative_cursor.field_40_=7;
    negative_cursor.field_64_=31; negative_cursor.field_68_=11; negative_cursor.field_44_=2;
    ListBoxDrawOffset=5;
    fill_target=&negative_cursor; fill_calls=0; negative_cursor.draw_item(0);
    assert(fill_calls==1 && fill_cursor==&rows[0] && fill_cursor_position==0);
    assert(fill_draw_position==4);
    assert(fill_rect.left==7 && fill_rect.top==120);
    assert(fill_rect.right==24 && fill_rect.bottom==144);
    ListBoxDrawOffset=0;

    // A high positive top beyond the list count leaves the old cursor in
    // place during initial positioning, then performs the original one-step
    // advance before the callback. This stale path is intentionally retained.
    ListBox stale_cursor;
    stale_cursor.item_list_.entry_count_=8; stale_cursor.item_list_.head_=&rows[0];
    stale_cursor.item_list_.current_=&rows[4];
    stale_cursor.item_list_.current_position_=1;
    stale_cursor.fill_callback_=&fill; stale_cursor.field_4C_=1;
    stale_cursor.field_18_=10; stale_cursor.field_4_=0;
    stale_cursor.field_38_=3; stale_cursor.field_40_=7;
    stale_cursor.field_64_=31; stale_cursor.field_68_=11; stale_cursor.field_44_=2;
    fill_target=&stale_cursor; fill_calls=0; stale_cursor.draw_item(2);
    assert(fill_calls==1 && fill_cursor==&rows[5] && fill_cursor_position==2);
    assert(fill_rect.left==7 && fill_rect.top==3);
    assert(fill_rect.right==24 && fill_rect.bottom==92);

    // Initial parent-null branch skips fallback fill/copy but still draws the
    // descriptor frame border after the callback path.
    ListBox orphan;
    orphan.item_list_.entry_count_=1; orphan.item_list_.head_=&rows[0];
    orphan.item_list_.current_=&rows[0]; orphan.fill_callback_=&fill;
    fill_target=&orphan; fill_calls=0; orphan.draw_item(0);
    assert(fill_calls==1 && orphan.fills==0 && orphan.copies==0);
    assert(orphan.boxes==1);

    // Parent's backfill flag is irrelevant: the flag belongs to child Win.
    GraphicWin first_parent, replacement_parent;
    ListBox child;
    child.item_list_.entry_count_=1; child.item_list_.head_=&rows[0];
    child.item_list_.current_=&rows[0]; child.fill_callback_=&fill;
    child.parent_=&first_parent; first_parent.iFlags_=0x80000u;
    child.iFlags_=0; fill_target=&child; fill_calls=0; child.draw_item(0);
    assert(first_parent.slot_calls==1 && child.fills==1 && first_parent.copies==0);
    assert(first_parent.slot_window==static_cast<GraphicWin *>(&child));

    // Backfill selection reads the child flag, not the parent's flag.
    first_parent.iFlags_=0; first_parent.slot_calls=0; child.fills=0;
    child.iFlags_=0x80000u; fill_target=&child; child.draw_item(0);
    assert(first_parent.copies==1 && first_parent.copy_destination==static_cast<Buffer *>(static_cast<GraphicWin *>(&child)));

    // A callback-mutated parent is reloaded. Child flag enables a copy from
    // the replacement parent into the child's Buffer; copy result is ignored.
    child.parent_=&first_parent; first_parent.slot_calls=0; first_parent.copies=0;
    first_parent.mutate_child=&child; first_parent.mutate_parent=&replacement_parent;
    child.iFlags_=0x80000u; child.fills=0; replacement_parent.copies=0;
    fill_target=&child; child.draw_item(0);
    assert(first_parent.slot_calls==1 && replacement_parent.copies==1);
    assert(replacement_parent.copy_destination==static_cast<Buffer *>(static_cast<GraphicWin *>(&child)));
    assert(replacement_parent.sx==fill_rect.left && replacement_parent.sy==fill_rect.top);
    assert(replacement_parent.dx==0 && replacement_parent.dy==0);
    assert(replacement_parent.width==37 && replacement_parent.height==19);
    assert(child.fills==0);

    // The frame callback can shrink the live list. The original checks the
    // new count before re-seeking; when index is now out of range, the
    // callback-visible cursor remains the prior one rather than being walked
    // through a list that no longer contains the row.
    GraphicWin shrinking_parent;
    ListBox shrinking_list;
    shrinking_list.item_list_.entry_count_=3;
    shrinking_list.item_list_.head_=&rows[0];
    shrinking_list.item_list_.current_=&rows[5];
    shrinking_list.item_list_.current_position_=5;
    shrinking_list.parent_=&shrinking_parent;
    shrinking_parent.mutate_list=&shrinking_list;
    shrinking_parent.mutate_count=1;
    shrinking_list.set_draw_callback(&bridge_draw_with_id);
    draw_target=&shrinking_list;
    bridge_draw_calls=0;
    shrinking_list.draw_item(1);
    assert(shrinking_list.item_list_.entry_count_==1);
    assert(bridge_draw_calls==1);
    assert(draw_cursor==&rows[5] && draw_cursor_position==5);
    draw_target=0;
    bridge_draw_calls=0;

    // Without a shrink, the same post-callback check still selects the row.
    GraphicWin stable_parent;
    ListBox stable_list;
    stable_list.item_list_.entry_count_=3;
    stable_list.item_list_.head_=&rows[0];
    stable_list.item_list_.current_=&rows[5];
    stable_list.item_list_.current_position_=5;
    stable_list.parent_=&stable_parent;
    stable_list.set_draw_callback(&bridge_draw_with_id);
    draw_target=&stable_list;
    stable_list.draw_item(1);
    assert(draw_cursor==&rows[1] && draw_cursor_position==1);
    draw_target=0;
    bridge_draw_calls=0;

    // Complete-object Dialogs receivers reach their first declared ListBox
    // base; callbacks see its compiler-converted GraphicWin virtual base.
    Dialogs dialog;
    GraphicWin bridge_parent;
    dialog.kind_=2; dialog.item_list_.entry_count_=1;
    dialog.item_list_.head_=&rows[0]; dialog.item_list_.current_=&rows[0];
    dialog.parent_=&bridge_parent;
    dialog.set_draw_callback(&bridge_draw_with_id);
    dialog.on_scrolled(-1, 7);
    assert(dialog.field_18_==7 && bridge_draw_calls==0 && dialog.redraws==1);
    assert(WinCallbackWindow==&bridge_parent && dialog.updates==0);
    int previous_draw_calls=bridge_draw_calls;
    int previous_updates=dialog.updates;
    dialog.on_scrolling(42, 999);
    assert(dialog.field_18_==7 && dialog.redraws==1);
    assert(bridge_draw_calls==previous_draw_calls);
    assert(dialog.updates==previous_updates+1);
    dialog.kind_=1; dialog.field_18_=7;
    dialog.on_scrolling(-1, 3);
    assert(dialog.field_18_==7); // non-list kind is not forwarded
    return 0;
}
